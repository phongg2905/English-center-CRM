# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supabase or PostgreSQL)
# Option 1: Connection Strings (Recommended for Supabase/Cloud)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Option 2: Discrete Configuration (Fallback for Localhost)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_center_crm
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=10000

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication (For Module BE-02)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=8h
