# ============================================================================
# EDUFLOW CRM - BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to backend/.env and fill in your actual values.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (Supabase PostgreSQL Cloud or Local PostgreSQL)
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Fallback Discrete Config
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_center_crm
DB_USER=postgres
DB_PASSWORD=<your-db-password>
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=10000

# JWT Authentication
JWT_SECRET=<your-strong-jwt-secret-key>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<your-strong-jwt-refresh-secret-key>
JWT_REFRESH_EXPIRES_IN=7d
