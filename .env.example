# ============================================================================
# EDUFLOW CRM - UNIFIED ENVIRONMENT VARIABLES TEMPLATE (VERCEL SERVICES)
# Copy this file to .env (or import on Vercel) and fill in your actual values.
# Never commit real credentials or secrets to GitHub!
# ============================================================================

# 1. Runtime & Frontend API Configuration
NODE_ENV=production
VITE_API_URL=/api
CORS_ORIGIN=*

# 2. PostgreSQL / Supabase Cloud Database Configuration
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Fallback Discrete Database Parameters
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<your-db-password>
DB_SSL=true
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=10000

# 3. JWT Authentication & Security
JWT_SECRET=<your-strong-jwt-secret-key>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<your-strong-jwt-refresh-secret-key>
JWT_REFRESH_EXPIRES_IN=7d
